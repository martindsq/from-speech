#!/bin/bash
#SBATCH --job-name=eval
#SBATCH --ntasks=1
#SBATCH --mem=2048
#SBATCH --time=0:30:00
#SBATCH --partition=normal
#SBATCH --qos=gpu
#SBATCH --output=eval.out
#SBATCH --gres=gpu:1
#SBATCH --mail-type=ALL

source /clusteruy/home/$USER/miniconda3/bin/activate
conda activate cowaver
cd ~/cowaver

python eval.py \
  --data /scratch/$USER/${SLURM_JOB_ID:-$(date +%Y%m%d%H%M%S)} \
  --checkpoints checkpoints/$SLURM_JOB_NAME \
  --hidden-size 128 \
  --filters 16
