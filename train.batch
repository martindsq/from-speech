#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --mem=2048
#SBATCH --time=1:00:00
#SBATCH --partition=normal
#SBATCH --qos=gpu
#SBATCH --output=%x.out
#SBATCH --gres=gpu:1
#SBATCH --mail-type=ALL

source /clusteruy/home/$USER/miniconda3/etc/profile.d/conda.sh
conda activate cowaver
cd ~/cowaver

# Architectures:
#   unconditioned, conditioned, dual-route
#
# Decoders:
#   convolutional, recurrent, transformer
#
# Adapters:
#   convolutional, recurrent, transformer
#
# Proportions:
#   letters, phonetized words, words
#
# Model dimensions:
#   latent_dim, hidden_size, mel_bins, width_steps, height_bands, seq_len
#
# Example:
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional transformer 256 256 80 24 4 49 8 50
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional transformer 256 256 80 24 4 49 8 50 1 0 0 0.5 0.5 0 0.1 0.5 0.4
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional transformer 256 256 80 24 4 49 8 50 1 0 0 0.5 0.5 0 0.1 0.5 0.4 reading-bridge
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional transformer 256 256 80 24 4 49 8 50 1 0 0 0.5 0.5 0 0.1 0.5 0.4 reading-bridge 0 4 5

ARCHITECTURE=${1:?Missing architecture}
DECODER=${2:?Missing decoder}
ADAPTER=${3:-convolutional}
LATENT_DIM=${4:-256}
HIDDEN_SIZE=${5:-256}
MEL_BINS=${6:-80}
WIDTH_STEPS=${7:-24}
HEIGHT_BANDS=${8:-4}
SEQ_LEN=${9:-49}
MAX_EPOCHS=${10:-30}
MAX_CLASSES=${11:-200}
PHASE1_LETTERS=${12:-1}
PHASE1_PHONES=${13:-0}
PHASE1_WORDS=${14:-0}
PHASE2_LETTERS=${15:-0.25}
PHASE2_PHONES=${16:-0.75}
PHASE2_WORDS=${17:-0}
PHASE3_LETTERS=${18:-0.10}
PHASE3_PHONES=${19:-0.15}
PHASE3_WORDS=${20:-0.75}
RUN_LABEL=${21:-}
PHASE1_MAX_WORD_LENGTH=${22:-0}
PHASE2_MAX_WORD_LENGTH=${23:-0}
PHASE3_MAX_WORD_LENGTH=${24:-0}
RUN_ID=${SLURM_JOB_ID:-$(date +%Y%m%d%H%M%S)}
CHECKPOINTS_PATH=checkpoints/$ARCHITECTURE/$ADAPTER/$DECODER/
if [ -n "$RUN_LABEL" ]; then
  CHECKPOINTS_PATH=checkpoints/$ARCHITECTURE/$ADAPTER/$DECODER/$RUN_LABEL/
fi

python train.py \
  -d /scratch/$USER/$RUN_ID \
  -c "$CHECKPOINTS_PATH" \
  --architecture $ARCHITECTURE \
  --adapter $ADAPTER \
  --decoder $DECODER \
  --latent-dim $LATENT_DIM \
  --hidden-size $HIDDEN_SIZE \
  --mel-bins $MEL_BINS \
  --width-steps $WIDTH_STEPS \
  --height-bands $HEIGHT_BANDS \
  --seq-len $SEQ_LEN \
  --phase1-proportions "$PHASE1_LETTERS" "$PHASE1_PHONES" "$PHASE1_WORDS" \
  --phase2-proportions "$PHASE2_LETTERS" "$PHASE2_PHONES" "$PHASE2_WORDS" \
  --phase3-proportions "$PHASE3_LETTERS" "$PHASE3_PHONES" "$PHASE3_WORDS" \
  --phase1-max-word-length "$PHASE1_MAX_WORD_LENGTH" \
  --phase2-max-word-length "$PHASE2_MAX_WORD_LENGTH" \
  --phase3-max-word-length "$PHASE3_MAX_WORD_LENGTH" \
  --max-epochs "$MAX_EPOCHS" \
  --max-classes "$MAX_CLASSES"
