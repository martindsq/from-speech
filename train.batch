#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --mem=2048
#SBATCH --time=1:00:00
#SBATCH --partition=normal
#SBATCH --qos=gpu
#SBATCH --output=%x.out
#SBATCH --gres=gpu:1
#SBATCH --mail-type=ALL

source /clusteruy/home/$USER/miniconda3/etc/profile.d/conda.sh
conda activate cowaver
cd ~/cowaver

# Architectures:
#   unconditioned, conditioned, dual-route
#
# Decoders:
#   convolutional, recurrent, transformer
#
# Adapters:
#   convolutional, recurrent, transformer
#
# Example:
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional transformer 256 256 50
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional transformer 256 256 50 90 3e-4 30 3e-5

ARCHITECTURE=${1:?Missing architecture}
DECODER=${2:?Missing decoder}
ADAPTER=${3:?Missing adapter}
LATENT_DIM=${4:-256}
HIDDEN_SIZE=${5:-256}
MAX_CLASSES=${6:-200}
THETA_MAX=${7:-60}
EPSILON_ZERO=${8:-3e-4}
THETA=${9:-45}
EPSILON_THETA=${10:-3e-5}

python train.py \
  --data /scratch/$USER/${SLURM_JOB_ID:-$(date +%Y%m%d%H%M%S)} \
  --architecture $ARCHITECTURE \
  --adapter $ADAPTER \
  --decoder $DECODER \
  --latent-dim $LATENT_DIM \
  --hidden-size $HIDDEN_SIZE \
  --max-classes "$MAX_CLASSES" \
  --theta-max "$THETA_MAX" \
  --epsilon-zero "$EPSILON_ZERO" \
  --theta "$THETA" \
  --epsilon-theta "$EPSILON_THETA" \
  --phase1-proportions 1 0 0 \
  --phase2-proportions 0.20 0.60 0.20 \
  --phase3-proportions 0.05 0.10 0.85 \
  --ctc-weight 0.1
