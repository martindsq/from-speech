#!/bin/bash
#SBATCH --ntasks=1
#SBATCH --mem=2048
#SBATCH --time=1:30:00
#SBATCH --partition=normal
#SBATCH --qos=gpu
#SBATCH --output=out/%x.out
#SBATCH --gres=gpu:1
#SBATCH --mail-type=ALL

source /clusteruy/home/$USER/miniconda3/etc/profile.d/conda.sh
conda activate cowaver
cd ~/cowaver

# Architectures:
#   unconditioned, conditioned, dual-route
#
# Adapters:
#   convolutional, pointwise
#
# Decoders:
#   convolutional, recurrent
#
# :xample:
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional recurrent 256 256 50
#   sbatch --job-name=MY_JOB_NAME train.batch dual-route convolutional recurrent 256 256 50 90 3e-4 30 3e-5

ARCHITECTURE=${1:?Missing architecture}
ADAPTER=${2:?Missing adapter}
DECODER=${3:?Missing decoder}
LATENT_DIM=${4:-256}
HIDDEN_SIZE=${5:-256}
MAX_CLASSES=${6:-200}
THETA_MAX=${7:-60}
EPSILON_ZERO=${8:-3e-4}
THETA=${9:-45}
EPSILON_THETA=${10:-3e-5}
PHASE1_LETTERS=${11:-1}
PHASE1_PHONES=${12:-0}
PHASE1_WORDS=${13:-0}
PHASE2_LETTERS=${14:-0.20}
PHASE2_PHONES=${15:-0.60}
PHASE2_WORDS=${16:-0.20}
PHASE3_LETTERS=${17:-0.05}
PHASE3_PHONES=${18:-0.10}
PHASE3_WORDS=${19:-0.85}

python train.py \
  --data /scratch/$USER/${SLURM_JOB_ID:-$(date +%Y%m%d%H%M%S)} \
  --checkpoints checkpoints/$SLURM_JOB_NAME \
  --architecture $ARCHITECTURE \
  --adapter $ADAPTER \
  --decoder $DECODER \
  --latent-dim $LATENT_DIM \
  --hidden-size $HIDDEN_SIZE \
  --max-classes "$MAX_CLASSES" \
  --theta-max "$THETA_MAX" \
  --epsilon-zero "$EPSILON_ZERO" \
  --theta "$THETA" \
  --epsilon-theta "$EPSILON_THETA" \
  --phase1 "$PHASE1_LETTERS" "$PHASE1_PHONES" "$PHASE1_WORDS" \
  --phase2 "$PHASE2_LETTERS" "$PHASE2_PHONES" "$PHASE2_WORDS" \
  --phase3 "$PHASE3_LETTERS" "$PHASE3_PHONES" "$PHASE3_WORDS"
